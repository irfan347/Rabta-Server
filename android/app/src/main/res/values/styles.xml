<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rabta.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/rabta_lime</item>
        <item name="android:statusBarColor">@color/rabta_graphite</item>
        <item name="android:navigationBarColor">@color/rabta_graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Rabta" parent="Theme.Rabta.Base" />
    <style name="Theme.Rabta.Light" parent="Theme.Rabta.Base">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#3A6E12</item>
        <item name="android:colorControlActivated">#3A6E12</item>
        <item name="android:textColorPrimary">#101820</item>
        <item name="android:textColorSecondary">#4F5E6B</item>
        <item name="android:colorBackground">#F5F7F4</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light</item>
        <item name="android:buttonStyle">@style/Widget.Rabta.Button</item>
    </style>
    <style name="Theme.Rabta.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#BFFF76</item>
        <item name="android:colorControlActivated">#BFFF76</item>
        <item name="android:textColorPrimary">#F3F6F5</item>
        <item name="android:textColorSecondary">#94A5B5</item>
        <item name="android:colorBackground">#080D14</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark</item>
        <item name="android:buttonStyle">@style/Widget.Rabta.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rabta_dialog_light</item>
        <item name="android:colorAccent">#3A6E12</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#101820</item>
        <item name="android:textColorSecondary">#4F5E6B</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Rabta.DialogButton</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark</item>
        <item name="android:colorAccent">#BFFF76</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#F3F6F5</item>
        <item name="android:textColorSecondary">#94A5B5</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Rabta.DialogButton</item>
    </style>
    <style name="Widget.Rabta.Button" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Rabta.DialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
