<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rabta.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/rabta_lime</item>
        <item name="android:statusBarColor">@color/rabta_graphite</item>
        <item name="android:navigationBarColor">@color/rabta_graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Rabta" parent="Theme.Rabta.Base" />
    <style name="Theme.Rabta.Light" parent="Theme.Rabta.Base">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#3A6E12</item>
        <item name="android:colorControlActivated">#3A6E12</item>
        <item name="android:textColorPrimary">#101820</item>
        <item name="android:textColorSecondary">#4F5E6B</item>
        <item name="android:colorBackground">#F5F7F4</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light</item>
        <item name="android:buttonStyle">@style/Widget.Rabta.Button</item>
    </style>
    <style name="Theme.Rabta.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#BFFF76</item>
        <item name="android:colorControlActivated">#BFFF76</item>
        <item name="android:textColorPrimary">#F3F6F5</item>
        <item name="android:textColorSecondary">#94A5B5</item>
        <item name="android:colorBackground">#080D14</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark</item>
        <item name="android:buttonStyle">@style/Widget.Rabta.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rabta_dialog_light</item>
        <item name="android:colorAccent">#3A6E12</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#101820</item>
        <item name="android:textColorSecondary">#4F5E6B</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Rabta.DialogButton</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark</item>
        <item name="android:colorAccent">#BFFF76</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#F3F6F5</item>
        <item name="android:textColorSecondary">#94A5B5</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Rabta.DialogButton</item>
    </style>
    <style name="Widget.Rabta.Button" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Rabta.DialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- Theme presets chosen in Appearance; NOVA is Theme.Rabta.Dark / Theme.Rabta.Light. Custom keeps neutral dialog buttons. -->
    <style name="Theme.Rabta.Dark.Ocean" parent="Theme.Rabta.Dark">
        <item name="android:colorAccent">#5FD3F3</item>
        <item name="android:colorControlActivated">#5FD3F3</item>
        <item name="android:colorBackground">#061018</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark.Ocean</item>
    </style>
    <style name="Theme.Rabta.Light.Ocean" parent="Theme.Rabta.Light">
        <item name="android:colorAccent">#0A6A86</item>
        <item name="android:colorControlActivated">#0A6A86</item>
        <item name="android:colorBackground">#F2F7FA</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light.Ocean</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark.Ocean" parent="Theme.Rabta.Dialog.Dark">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark_ocean</item>
        <item name="android:colorAccent">#5FD3F3</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light.Ocean" parent="Theme.Rabta.Dialog.Light">
        <item name="android:colorAccent">#0A6A86</item>
    </style>
    <style name="Theme.Rabta.Dark.Royal" parent="Theme.Rabta.Dark">
        <item name="android:colorAccent">#C2A8FF</item>
        <item name="android:colorControlActivated">#C2A8FF</item>
        <item name="android:colorBackground">#0C0A15</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark.Royal</item>
    </style>
    <style name="Theme.Rabta.Light.Royal" parent="Theme.Rabta.Light">
        <item name="android:colorAccent">#5B3FC4</item>
        <item name="android:colorControlActivated">#5B3FC4</item>
        <item name="android:colorBackground">#F6F4FB</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light.Royal</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark.Royal" parent="Theme.Rabta.Dialog.Dark">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark_royal</item>
        <item name="android:colorAccent">#C2A8FF</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light.Royal" parent="Theme.Rabta.Dialog.Light">
        <item name="android:colorAccent">#5B3FC4</item>
    </style>
    <style name="Theme.Rabta.Dark.Emerald" parent="Theme.Rabta.Dark">
        <item name="android:colorAccent">#3DDC97</item>
        <item name="android:colorControlActivated">#3DDC97</item>
        <item name="android:colorBackground">#0B1411</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark.Emerald</item>
    </style>
    <style name="Theme.Rabta.Light.Emerald" parent="Theme.Rabta.Light">
        <item name="android:colorAccent">#0B6E4F</item>
        <item name="android:colorControlActivated">#0B6E4F</item>
        <item name="android:colorBackground">#F1F4F1</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light.Emerald</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark.Emerald" parent="Theme.Rabta.Dialog.Dark">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark_emerald</item>
        <item name="android:colorAccent">#3DDC97</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light.Emerald" parent="Theme.Rabta.Dialog.Light">
        <item name="android:colorAccent">#0B6E4F</item>
    </style>
    <style name="Theme.Rabta.Dark.Custom" parent="Theme.Rabta.Dark">
        <item name="android:colorAccent">#E8EAED</item>
        <item name="android:colorControlActivated">#E8EAED</item>
        <item name="android:colorBackground">#0E0F12</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Dark.Custom</item>
    </style>
    <style name="Theme.Rabta.Light.Custom" parent="Theme.Rabta.Light">
        <item name="android:colorAccent">#202328</item>
        <item name="android:colorControlActivated">#202328</item>
        <item name="android:colorBackground">#F5F5F7</item>
        <item name="android:alertDialogTheme">@style/Theme.Rabta.Dialog.Light.Custom</item>
    </style>
    <style name="Theme.Rabta.Dialog.Dark.Custom" parent="Theme.Rabta.Dialog.Dark">
        <item name="android:windowBackground">@drawable/rabta_dialog_dark_custom</item>
        <item name="android:colorAccent">#E8EAED</item>
    </style>
    <style name="Theme.Rabta.Dialog.Light.Custom" parent="Theme.Rabta.Dialog.Light">
        <item name="android:colorAccent">#202328</item>
    </style>
</resources>
